{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlueSky PRO Verification Evidence Record",
  "type": "object",
  "required": ["test_run_id", "status", "configuration", "events"],
  "properties": {
    "test_run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "NOT_PERFORMED", "IN_PROGRESS", "ANALYZED", "PASS", "FAIL", "INVALID"]},
    "data_class": {"type": "string"},
    "evidence_domain_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EC-[0-9]{2}$"},
      "uniqueItems": true
    },
    "requirement_ids": {"type": "array", "items": {"type": "string"}},
    "test_method_id": {"type": ["string", "null"]},
    "test_method_revision": {"type": ["string", "null"]},
    "test_case_id": {"type": ["string", "null"]},
    "test_case_revision": {"type": ["string", "null"]},
    "configuration_id": {"type": ["string", "null"]},
    "flight_record_id": {"type": ["string", "null"]},
    "configuration": {"type": "object"},
    "started_at_ms": {"type": ["integer", "null"]},
    "ended_at_ms": {"type": ["integer", "null"]},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp_ms", "parameter", "value", "unit", "source"],
        "properties": {
          "timestamp_ms": {"type": "integer"},
          "parameter": {"type": "string"},
          "value": {},
          "unit": {"type": "string"},
          "source": {"type": "string"},
          "quality": {"type": ["string", "null"]},
          "context": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
