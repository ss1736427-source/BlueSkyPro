{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bluesky://schemas/mission-model/v1",
  "title": "BlueSky PRO Common Mission Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["missionId", "version", "intent", "objectiveProfile", "environment", "vehicles", "constraints"],
  "properties": {
    "missionId": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "parentMissionId": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "description": {"type": "string"},
        "timeWindow": {"type": ["object", "null"]}
      }
    },
    "objectiveProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId"],
      "properties": {
        "profileId": {"type": "string"},
        "objectives": {"type": "array", "items": {"type": "object"}},
        "acceptanceCriteria": {"type": "array", "items": {"type": "object"}}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operatingArea": {"type": "object"},
        "terrain": {"type": ["object", "null"]},
        "airspace": {"type": ["object", "null"]},
        "weather": {"type": ["object", "null"]},
        "wind": {"type": ["object", "null"]},
        "timestamp": {"type": ["string", "null"]},
        "sourceVersions": {"type": "object"}
      }
    },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vehicleId", "configurationId"],
        "properties": {
          "vehicleId": {"type": "string"},
          "configurationId": {"type": "string"},
          "autopilot": {"type": "object"},
          "propulsion": {"type": "object"},
          "battery": {"type": "object"},
          "payload": {"type": "object"},
          "communications": {"type": "object"},
          "performanceEnvelope": {"type": "object"}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hard": {"type": "array", "items": {"type": "object"}},
        "soft": {"type": "array", "items": {"type": "object"}}
      }
    },
    "geometry": {"type": ["object", "null"]},
    "algorithmContext": {"type": ["object", "null"]},
    "validation": {"type": ["object", "null"]},
    "traceability": {"type": ["object", "null"]}
  }
}
