{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bluesky://schemas/mission-model/v2",
  "title": "BlueSky PRO Canonical Versioned Mission Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "missionId",
    "status",
    "missionVersion",
    "missionMode",
    "selectedTemplateIds",
    "task",
    "intent",
    "geometryObjects",
    "vehicleAssignments",
    "equipmentAssignments"
  ],
  "properties": {
    "missionId": {
      "type": "string",
      "minLength": 1
    },
    "missionVersion": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "missionMode": {
      "type": "string",
      "enum": [
        "AUTO",
        "MANUAL"
      ]
    },
    "selectedTemplateIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MT-(0[1-9]|1[0-3])$"
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "taskType"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "taskType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mandatory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optimizationCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environmentSnapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshotId",
          "version"
        ],
        "properties": {
          "snapshotId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "origin": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "longitudeDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitudeDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "coordinateReferenceSystem": {
          "const": "EPSG:4326"
        },
        "originKind": {
          "type": "string"
        },
        "horizontalAccuracyM": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "trueNorthBearingDeg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "exclusiveMaximum": 360
        }
      },
      "required": [
        "longitudeDeg",
        "latitudeDeg",
        "coordinateReferenceSystem",
        "originKind"
      ]
    },
    "vehicleAssignments": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vehicleId",
          "configurationId",
          "configurationVersion",
          "configurationType",
          "validationState",
          "approvalState"
        ],
        "properties": {
          "vehicleId": {
            "type": "string",
            "minLength": 1
          },
          "configurationId": {
            "type": "string",
            "minLength": 1
          },
          "configurationVersion": {
            "type": "string",
            "minLength": 1
          },
          "configurationType": {
            "type": "string",
            "enum": [
              "STANDARD",
              "CUSTOM",
              "DERIVED"
            ]
          },
          "validationState": {
            "type": "string",
            "enum": [
              "DRAFT",
              "VALIDATING",
              "VALIDATED",
              "APPROVED",
              "INVALID"
            ]
          },
          "approvalState": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "SUSPENDED",
              "NOT_REQUIRED"
            ]
          }
        }
      }
    },
    "equipmentAssignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vehicleId",
          "equipmentId",
          "equipmentProfileId",
          "equipmentClass",
          "configurationVersion",
          "compatibilityState",
          "verificationState",
          "calibrationState"
        ],
        "properties": {
          "vehicleId": {
            "type": "string",
            "minLength": 1
          },
          "equipmentId": {
            "type": "string",
            "minLength": 1
          },
          "equipmentProfileId": {
            "type": "string",
            "minLength": 1
          },
          "equipmentClass": {
            "type": "string",
            "minLength": 1
          },
          "configurationVersion": {
            "type": "string",
            "minLength": 1
          },
          "compatibilityState": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "COMPATIBLE",
              "NOT_COMPATIBLE",
              "NEEDS_REVIEW"
            ]
          },
          "verificationState": {
            "type": "string",
            "enum": [
              "NOT_VERIFIED",
              "VERIFIED",
              "EXPIRED",
              "INVALIDATED"
            ]
          },
          "calibrationState": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "geometryObjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "geometryId",
          "geometryType",
          "coordinateReferenceSystem",
          "coordinates",
          "templateIds",
          "version"
        ],
        "properties": {
          "geometryId": {
            "type": "string",
            "minLength": 1
          },
          "geometryType": {
            "type": "string",
            "enum": [
              "POINT",
              "WAYPOINT_ROUTE",
              "POLYGON_AOI",
              "COVERAGE_GRID",
              "CORRIDOR",
              "ORBIT",
              "INSPECTION_POINTS",
              "SEARCH_AREA",
              "DELIVERY_ROUTE",
              "OBSERVATION_POINTS"
            ]
          },
          "coordinateReferenceSystem": {
            "const": "EPSG:4326"
          },
          "coordinates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "items": false
            }
          },
          "templateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^MT-(0[1-9]|1[0-3])$"
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "CONFIGURATION_PENDING",
        "PLANNING",
        "UNDER_REVIEW",
        "READY_FOR_TRANSFER",
        "BLOCKED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY_FOR_TRANSFER"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "vehicleAssignments": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
