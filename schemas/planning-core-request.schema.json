{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"BlueSky Planning Core JSONL request",
  "type":"object",
  "required":["schemaVersion","messageType","missionId","resultId","inputs"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "messageType":{"const":"planning.request"},
    "missionId":{"type":"string","minLength":1},
    "resultId":{"type":"string","minLength":1},
    "source":{"type":"object"},
    "traceability":{"type":"object"},
    "inputs":{
      "type":"object",
      "required":["zoneStatus","assignmentStatus","routes","performance","trajectories","minimums"],
      "properties":{
        "zoneStatus":{"type":"string"},
        "assignmentStatus":{"type":"string"},
        "routes":{"type":"array","minItems":1},
        "performance":{"type":"array"},
        "trajectories":{"type":"array"},
        "minimums":{"type":"object","required":["horizontalM","verticalM"]},
        "resolutionPolicy":{"type":"object"},
        "routeGeometry":{
          "type":"object",
          "additionalProperties":false,
          "required":["routeId","routeVersion","coordinateReference","points"],
          "properties":{
            "routeId":{"type":"string","minLength":1},
            "routeVersion":{"type":"string","minLength":1},
            "coordinateReference":{"const":"WGS84"},
            "points":{
              "type":"array",
              "minItems":2,
              "items":{
                "type":"object",
                "additionalProperties":false,
                "required":["waypointId","latitude","longitude","altitudeM","mandatory"],
                "properties":{
                  "waypointId":{"type":"string","minLength":1},
                  "latitude":{"type":"number","minimum":-90,"maximum":90},
                  "longitude":{"type":"number","minimum":-180,"maximum":180},
                  "altitudeM":{"type":"number"},
                  "mandatory":{"type":"boolean"}
                }
              }
            }
          }
        },
        "threeDMapping":{"type":"object"}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}