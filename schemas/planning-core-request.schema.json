{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlueSky Planning Core JSONL request",
  "type": "object",
  "required": [
    "schemaVersion",
    "messageType",
    "missionId",
    "resultId",
    "inputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "messageType": {
      "const": "planning.request"
    },
    "missionId": {
      "type": "string",
      "minLength": 1
    },
    "resultId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    },
    "traceability": {
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "required": [
        "zoneStatus",
        "assignmentStatus",
        "routes",
        "performance",
        "trajectories",
        "minimums"
      ],
      "properties": {
        "zoneStatus": {
          "type": "string"
        },
        "assignmentStatus": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "minItems": 1
        },
        "performance": {
          "type": "array"
        },
        "trajectories": {
          "type": "array"
        },
        "minimums": {
          "type": "object",
          "required": [
            "horizontalM",
            "verticalM"
          ]
        },
        "resolutionPolicy": {
          "type": "object"
        },
        "threeDMapping": {
          "type": "object"
        },
        "routeCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "routeId",
            "routeVersion",
            "missionId",
            "missionVersion",
            "generatorId",
            "generatorVersion",
            "calculationInputVersion",
            "environmentSnapshotRefs",
            "coordinateReferenceSystem",
            "waypoints",
            "segments",
            "trajectoryGeometryComplete",
            "validationState"
          ],
          "properties": {
            "routeId": {
              "type": "string",
              "minLength": 1
            },
            "routeVersion": {
              "type": "string",
              "minLength": 1
            },
            "missionId": {
              "type": "string",
              "minLength": 1
            },
            "missionVersion": {
              "type": "string",
              "minLength": 1
            },
            "generatorId": {
              "type": "string",
              "minLength": 1
            },
            "generatorVersion": {
              "type": "string",
              "minLength": 1
            },
            "calculationInputVersion": {
              "type": "string",
              "minLength": 1
            },
            "environmentSnapshotRefs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "terrainSnapshotId",
                "airspaceSnapshotId",
                "weatherSnapshotId",
                "windSnapshotId"
              ],
              "properties": {
                "terrainSnapshotId": {
                  "type": "string",
                  "minLength": 1
                },
                "airspaceSnapshotId": {
                  "type": "string",
                  "minLength": 1
                },
                "weatherSnapshotId": {
                  "type": "string"
                },
                "windSnapshotId": {
                  "type": "string"
                }
              }
            },
            "coordinateReferenceSystem": {
              "const": "EPSG:4326"
            },
            "waypoints": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "waypointId",
                  "latitudeDeg",
                  "longitudeDeg",
                  "altitudeM",
                  "mandatory",
                  "altitudeReference"
                ],
                "properties": {
                  "waypointId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "latitudeDeg": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitudeDeg": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "altitudeM": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5000
                  },
                  "mandatory": {
                    "type": "boolean"
                  },
                  "altitudeReference": {
                    "const": "AGL"
                  }
                }
              }
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "segmentId",
                  "fromWaypointId",
                  "toWaypointId",
                  "distanceM",
                  "nominalSpeedMps"
                ],
                "properties": {
                  "segmentId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fromWaypointId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "toWaypointId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "distanceM": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "nominalSpeedMps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "bankAngleRad": {
                    "type": "number",
                    "minimum": 0
                  },
                  "lateralAccelerationMps2": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "trajectoryGeometryComplete": {
              "const": true
            },
            "validationState": {
              "const": "VALIDATED"
            }
          }
        },
        "routeCandidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "routeId",
              "routeVersion",
              "missionId",
              "missionVersion",
              "generatorId",
              "generatorVersion",
              "calculationInputVersion",
              "environmentSnapshotRefs",
              "coordinateReferenceSystem",
              "waypoints",
              "segments",
              "trajectoryGeometryComplete",
              "validationState",
              "candidateId",
              "estimatedTimeS",
              "estimatedEnergyWh",
              "estimatedReserveWh",
              "objectiveScore",
              "flightSafetyValidationState",
              "flightSafetyEnvelopeId",
              "flightSafetyVehicleId"
            ],
            "properties": {
              "routeId": {
                "type": "string",
                "minLength": 1
              },
              "routeVersion": {
                "type": "string",
                "minLength": 1
              },
              "missionId": {
                "type": "string",
                "minLength": 1
              },
              "missionVersion": {
                "type": "string",
                "minLength": 1
              },
              "generatorId": {
                "type": "string",
                "minLength": 1
              },
              "generatorVersion": {
                "type": "string",
                "minLength": 1
              },
              "calculationInputVersion": {
                "type": "string",
                "minLength": 1
              },
              "environmentSnapshotRefs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "terrainSnapshotId",
                  "airspaceSnapshotId",
                  "weatherSnapshotId",
                  "windSnapshotId"
                ],
                "properties": {
                  "terrainSnapshotId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "airspaceSnapshotId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weatherSnapshotId": {
                    "type": "string"
                  },
                  "windSnapshotId": {
                    "type": "string"
                  }
                }
              },
              "coordinateReferenceSystem": {
                "const": "EPSG:4326"
              },
              "waypoints": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "waypointId",
                    "latitudeDeg",
                    "longitudeDeg",
                    "altitudeM",
                    "mandatory",
                    "altitudeReference"
                  ],
                  "properties": {
                    "waypointId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "latitudeDeg": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "longitudeDeg": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "altitudeM": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 5000
                    },
                    "mandatory": {
                      "type": "boolean"
                    },
                    "altitudeReference": {
                      "const": "AGL"
                    }
                  }
                }
              },
              "segments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segmentId",
                    "fromWaypointId",
                    "toWaypointId",
                    "distanceM",
                    "nominalSpeedMps"
                  ],
                  "properties": {
                    "segmentId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fromWaypointId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "toWaypointId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "distanceM": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "nominalSpeedMps": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "bankAngleRad": {
                      "type": "number",
                      "minimum": 0
                    },
                    "lateralAccelerationMps2": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "trajectoryGeometryComplete": {
                "const": true
              },
              "validationState": {
                "const": "VALIDATED"
              },
              "candidateId": {
                "type": "string",
                "minLength": 1
              },
              "estimatedTimeS": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "estimatedEnergyWh": {
                "type": "number",
                "minimum": 0
              },
              "estimatedReserveWh": {
                "type": "number",
                "minimum": 0
              },
              "objectiveScore": {
                "type": "number"
              },
              "flightSafetyValidationState": {
                "const": "ALLOWED"
              },
              "flightSafetyEnvelopeId": {
                "type": "string",
                "minLength": 1
              },
              "flightSafetyVehicleId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "selectedCandidateId": {
          "type": "string"
        },
        "objectivePriorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "completion_time",
              "time",
              "fast",
              "energy",
              "endurance",
              "reserve"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
