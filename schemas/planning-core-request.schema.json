{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlueSky Planning Core JSONL request",
  "type": "object",
  "required": [
    "schemaVersion",
    "messageType",
    "missionId",
    "resultId",
    "inputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "messageType": {
      "const": "planning.request"
    },
    "missionId": {
      "type": "string",
      "minLength": 1
    },
    "resultId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    },
    "traceability": {
      "type": "object"
    },
    "inputs": {
      "type": "object",
      "required": [
        "zoneStatus",
        "assignmentStatus",
        "routes",
        "performance",
        "trajectories",
        "minimums"
      ],
      "properties": {
        "zoneStatus": {
          "type": "string"
        },
        "assignmentStatus": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "minItems": 1
        },
        "performance": {
          "type": "array"
        },
        "trajectories": {
          "type": "array"
        },
        "minimums": {
          "type": "object",
          "required": [
            "horizontalM",
            "verticalM"
          ]
        },
        "resolutionPolicy": {
          "type": "object"
        },
        "threeDMapping": {
          "type": "object"
        },
        "routeCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "routeId",
            "routeVersion",
            "missionId",
            "missionVersion",
            "generatorId",
            "generatorVersion",
            "calculationInputVersion",
            "coordinateReferenceSystem",
            "waypoints"
          ],
          "properties": {
            "routeId": {
              "type": "string",
              "minLength": 1
            },
            "routeVersion": {
              "type": "string",
              "minLength": 1
            },
            "missionId": {
              "type": "string",
              "minLength": 1
            },
            "missionVersion": {
              "type": "string",
              "minLength": 1
            },
            "generatorId": {
              "type": "string",
              "minLength": 1
            },
            "generatorVersion": {
              "type": "string",
              "minLength": 1
            },
            "calculationInputVersion": {
              "type": "string",
              "minLength": 1
            },
            "coordinateReferenceSystem": {
              "const": "EPSG:4326"
            },
            "waypoints": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "waypointId",
                  "latitudeDeg",
                  "longitudeDeg",
                  "altitudeM",
                  "mandatory",
                  "altitudeReference"
                ],
                "properties": {
                  "waypointId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "latitudeDeg": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitudeDeg": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "altitudeM": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5000
                  },
                  "mandatory": {
                    "type": "boolean"
                  },
                  "altitudeReference": {
                    "const": "AGL"
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
