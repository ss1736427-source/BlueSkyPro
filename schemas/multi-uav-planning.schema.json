        },
        "parentArtifactId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "algorithmVersion": {
          "type": "string"
        },
        "configVersion": {
          "type": "string"
        },
        "traceability": {
          "$ref": "#/$defs/Traceability"
        },
